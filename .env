# AcadSphere Local Security Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_SECRET=acad_sec_jwt_auth_access_token_super_secret_key_32_bytes_min
JWT_REFRESH_SECRET=acad_sec_jwt_refresh_token_super_secret_key_32_bytes_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
AUTH_RATE_LIMIT_MAX=5
AUTH_LOCKOUT_DURATION_MS=900000
BCRYPT_SALT_ROUNDS=12
