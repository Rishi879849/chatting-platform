# ==============================================================================
# AcadSphere Enterprise Security Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Port
PORT=5000

# Client Application URL for Strict CORS Whitelisting
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cryptographically Secure JWT Secret for Access Tokens (32+ characters)
JWT_SECRET=your_super_secret_access_jwt_key_minimum_32_chars_long

# Cryptographically Secure JWT Secret for Refresh Tokens (32+ characters)
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_minimum_32_chars_long

# Token Expiry Durations
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_LOCKOUT_DURATION_MS=900000

# Bcrypt Salt Rounds for Password Hashing (10-12 recommended)
BCRYPT_SALT_ROUNDS=12
